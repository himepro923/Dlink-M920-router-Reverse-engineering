serial: 8250_dw: polled mode, always read LSR, wait for THRE before each TX write, port-state diagnostics (RTL8197F M920)

--- a/drivers/tty/serial/8250/8250_dw.c
+++ b/drivers/tty/serial/8250/8250_dw.c
@@ -25,6 +25,7 @@
 #include <linux/slab.h>
 #include <linux/acpi.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
 #include <linux/reset.h>
 #include <linux/pm_runtime.h>
 
@@ -186,11 +187,33 @@
 }
 #endif /* CONFIG_64BIT */
 
+/*
+ * RTL8197F (M920): bursts of characters written by the tty layer (up to tx_loadsz at once) never
+ * reach the wire although the console, which waits for THRE before every character, works. Do the
+ * same here: before every transmit-register write wait (bounded) until the UART can take it.
+ */
+static unsigned int dw8250_thre_waits;
+
+static void dw8250_wait_thre(struct uart_port *p)
+{
+	int i;
+
+	for (i = 0; i < 20000; i++) {
+		if (readl(p->membase + (UART_LSR << p->regshift)) & UART_LSR_THRE)
+			return;
+		if (!i)
+			dw8250_thre_waits++;
+		udelay(1);
+	}
+}
+
 static void dw8250_serial_out32(struct uart_port *p, int offset, int value)
 {
 	struct dw8250_data *d = p->private_data;
 
 	offset = dw_change_offset(p, offset);
+	if (offset == 9 && d->adjlcr)
+		dw8250_wait_thre(p);
 	writel(value, p->membase + (offset << p->regshift));
 
 	if (offset == UART_LCR && !d->uart_16550_compatible)
@@ -232,6 +255,17 @@
 	unsigned int iir = p->serial_in(p, UART_IIR);
 	unsigned int status;
 	unsigned long flags;
+	static int dbg_left = 24;
+
+	/* Diagnostics: report unusual interrupt ids (not none/THRE/RX/RX-timeout) a few times. */
+	if (dbg_left && !(iir & UART_IIR_NO_INT) &&
+	    (iir & 0x3f) != UART_IIR_THRI && (iir & 0x3f) != UART_IIR_RDI &&
+	    (iir & 0x3f) != UART_IIR_RX_TIMEOUT) {
+		dbg_left--;
+		pr_info("dw8250: unusual iir=%02x lsr=%02x msr=%02x ier=%02x\n", iir,
+			p->serial_in(p, UART_LSR), p->serial_in(p, UART_MSR),
+			p->serial_in(p, UART_IER));
+	}
 
 	/*
 	 * There are ways to get Designware-based UARTs into a state where
@@ -253,6 +287,38 @@
 		spin_unlock_irqrestore(&p->lock, flags);
 	}
 
+	/* Diagnostics: every ~5 s (first 40 times) report the tx/rx state of the port while it is open. */
+	{
+		static unsigned long dbg_next;
+		static int dbg_n;
+		static bool dbg_init;
+
+		if (!dbg_init) {
+			dbg_init = true;
+			dbg_next = jiffies;
+		}
+
+		if (p->state && dbg_n < 40 && time_after_eq(jiffies, dbg_next)) {
+			dbg_next = jiffies + 5 * HZ;
+			dbg_n++;
+			pr_info("dw8250: st pend=%d stopped=%d tx=%u rx=%u ovr=%u ier=%02x lcr=%02x mcr=%02x lsr=%02x iir=%02x waits=%u\n",
+				uart_circ_chars_pending(&p->state->xmit), uart_tx_stopped(p),
+				p->icount.tx, p->icount.rx, p->icount.overrun,
+				p->serial_in(p, UART_IER), p->serial_in(p, UART_LCR),
+				p->serial_in(p, UART_MCR), p->serial_in(p, UART_LSR), iir,
+				dw8250_thre_waits);
+		}
+	}
+
+	/*
+	 * Polled mode (no interrupt line): the RTL8197F UART does not report a pending
+	 * THRE interrupt in IIR when THRI is switched on while the transmitter is already
+	 * empty, so the timer poll sees "no interrupt" and never starts queued tty output
+	 * until a character happens to arrive. Always look at LSR when polling.
+	 */
+	if (!p->irq)
+		iir &= ~UART_IIR_NO_INT;
+
 	if (serial8250_handle_irq(p, iir))
 		return 1;
 
@@ -458,9 +524,15 @@
 	}
 
 	if (irq < 0) {
-		if (irq != -EPROBE_DEFER)
-			dev_err(dev, "cannot get irq\n");
-		return irq;
+		if (irq == -EPROBE_DEFER)
+			return irq;
+		/*
+		 * No usable interrupt: run the port polled (the 8250 core
+		 * kicks it from a timer when irq == 0). RTL8197F boards use
+		 * this when the UART interrupt line cannot be quiesced.
+		 */
+		dev_info(dev, "no irq, using polled mode\n");
+		irq = 0;
 	}
 
 	spin_lock_init(&p->lock);
