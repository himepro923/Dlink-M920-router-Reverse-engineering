# DWR-M920 bring-up diagnostics (test 10).
# Userspace output on the serial console is the open problem. Kernel messages (/dev/kmsg) do reach
# the wire, so the checks below report through them. Background, never blocks boot.
(
	sleep 30
	echo "m920: tty write test 1 now (look for TTYTEST-1 on the console)" > /dev/kmsg
	echo "TTYTEST-1-via-ttyS0" > /dev/ttyS0 2>/dev/kmsg
	sleep 3
	echo "m920: tty write test 2 now: 60 characters in one write" > /dev/kmsg
	echo "0123456789-0123456789-0123456789-0123456789-0123456789-ABCD" > /dev/ttyS0 2>/dev/kmsg
	sleep 3
	echo "m920: tty tests done" > /dev/kmsg
	# fallback shell directly on the serial port
	setsid /bin/sh -c 'exec /bin/ash --login </dev/ttyS0 >/dev/ttyS0 2>&1' &
) &
exit 0
